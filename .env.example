# Copy to .env to override docker compose defaults.
TENANTPAY_JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
TENANTPAY_ASAAS_WEBHOOK_TOKEN=dev-webhook-token
TENANTPAY_DEV_TOOLS_ENABLED=true
# Leave empty to use the deterministic FakeAsaasGateway.
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
