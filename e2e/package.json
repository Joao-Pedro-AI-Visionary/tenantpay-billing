{
  "name": "tenantpay-billing-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "End to end tests for TenantPay Billing (Playwright, Chromium)",
  "scripts": {
    "test": "playwright test",
    "test:demo": "playwright test -c playwright.demo.config.ts",
    "test:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit",
    "install-browser": "playwright install chromium",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
